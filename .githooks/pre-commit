#!/bin/sh
# Blocks commits containing secrets (API keys, tokens, live agentbus
# tickets). Wired via: git config core.hooksPath .githooks
# Bypass for a confirmed false positive: git commit --no-verify
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed — refusing to commit unscanned." >&2
  echo "install: https://github.com/gitleaks/gitleaks/releases" >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner
